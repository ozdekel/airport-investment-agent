{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "module": "commonjs",
    "moduleResolution": "node",
    "target": "ES2022",
    "outDir": ".test-build",
    "incremental": false,
    "jsx": "react-jsx",
    "types": ["node"]
  },
  "include": ["src/core/**/*.ts", "src/ai/guardrails.ts", "src/data/regions.ts", "tests/**/*.ts"],
  "exclude": ["node_modules", ".next"]
}
